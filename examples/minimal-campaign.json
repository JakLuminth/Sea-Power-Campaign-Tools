{
  "schemaVersion": 1,
  "campaign": {
    "id": "example-campaign",
    "displayName": "Example Campaign",
    "root": "../mod/campaigns/example-campaign",
    "metadata": "../mod/_info.ini",
    "campaignsRoot": "../mod/campaigns",
    "ini": "campaign.ini"
  },
  "locales": ["en"],
  "briefing": {
    "content": "briefing_content.json",
