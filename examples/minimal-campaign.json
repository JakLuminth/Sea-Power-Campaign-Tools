    "requiredHeadings": {"en": ["SITUATION", "MISSION", "EXECUTION", "RULES OF ENGAGEMENT", "FRIENDLY FORCES", "SUPPORT"]},
    "labels": {"en": {"brief": "MISSION BRIEF", "footer": "FOLLOW TASKING", "situation": "SITUATION", "mission": "MISSION", "execution": "EXECUTION", "roe": "RULES OF ENGAGEMENT", "friendly": "FRIENDLY FORCES", "support": "SUPPORT"}},
    "branding": {"header": "EXAMPLE CAMPAIGN"}
  }
}
